#!/usr/bin/python3 -I
"""Root-owned, fixed-scope hosts lease helper. No user code is imported."""
import contextlib
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time
import copy
import math

BASE = Path('/Library/PrivilegedHelperTools/focus-open')
# Only this root-owned installation directory is added in isolated mode.
sys.path.insert(0, str(BASE))
import focus_youtube_guard as youtube
import focus_service_policy as socials
import focus_playlist_sync as playlist_sync
import focus_study as study_lock
HOSTS = Path('/etc/hosts')
STATE = BASE / 'lease.json'
HEARTBEAT = BASE / 'heartbeat'
PREFIX = '# TEMP_FOCUS_UNLOCK '
SOCIAL_SERVICES = tuple(socials.DURATIONS)
TEMPORARY_SERVICES = ('youtube',) + SOCIAL_SERVICES
PERMANENT_BLOCKS = ('vkvideo',)
PERMANENT_DOMAINS = {
    'vkvideo': (
        'vkvideo.ru', 'www.vkvideo.ru', 'm.vkvideo.ru',
        'api.vkvideo.ru', 'live.vkvideo.ru', 'api.live.vkvideo.ru',
        'video.vk.com',
    ),
}


_BOOT = None


def boot_identity():
    global _BOOT
    if _BOOT is None:
        result = subprocess.run(['/usr/sbin/sysctl', '-n', 'kern.boottime'],
                                capture_output=True, text=True, timeout=3, check=True)
        if not result.stdout.strip():
            raise RuntimeError('Cannot identify the current system boot')
        _BOOT = result.stdout.strip()
    return _BOOT


def study_status():
    return study_lock.status(boot_identity())


def require_no_focus():
    current = study_status()['session']
    if current and current['phase'] == 'focus':
        raise RuntimeError('Идёт учебный блок. Развлекательный доступ закрыт до его окончания.')


def guard_study_apps():
    current = study_status()['session']
    if not current or current['phase'] != 'focus':
        return
    # IDs are validated by the protected module. Hide rather than terminate:
    # no unsaved documents or background processes are killed.
    allowed = '{' + ', '.join(json.dumps(app) for app in current['apps']) + '}'
    script = '''tell application "System Events"
        set frontProcess to first application process whose frontmost is true
        set frontID to bundle identifier of frontProcess
        if frontID is missing value then return ""
        if frontID is not in ALLOWED then
            set visible of frontProcess to false
            return frontID
        end if
    end tell
    return ""'''.replace('ALLOWED', allowed)
    blocked = youtube.user_script(script).strip()
    study_lock.app_health(None)
    if blocked:
        study_lock.record_attempt('app', blocked)


def start_study(request):
    require_timer()
    require_observer()
    if read_lease():
        raise RuntimeError('Сначала заверши текущий временный доступ к развлечениям.')
    transform(HOSTS.read_text(), 'study_web', False)  # Validate before committing.
    # Check frontmost-app observation permission before committing 80 minutes.
    youtube.user_script('''tell application "System Events"
        set frontProcess to first application process whose frontmost is true
        set visible of frontProcess to visible of frontProcess
        return bundle identifier of frontProcess
    end tell''')
    value = study_lock.start(request, boot_identity())
    for service in SOCIAL_SERVICES:
        set_access(service, False)
    guard_cycle()
    return value


def set_study_web(active):
    # Compatibility for older hosts fixtures/installations while idle. An
    # active block always requires the installed marker (checked on start).
    if active or '# === FOCUS_BLOCK:STUDY_WEB START ===' in HOSTS.read_text():
        set_access('study_web', not active)


def transform(text, service, unlock):
    lines = text.splitlines(keepends=True)
    start = '# === FOCUS_BLOCK:' + service.upper() + ' START ==='
    end = '# === FOCUS_BLOCK:' + service.upper() + ' END ==='
    a = next((i for i, line in enumerate(lines) if line.strip() == start), None)
    b = next((i for i, line in enumerate(lines) if line.strip() == end), None)
    if a is None or b is None or b <= a:
        raise RuntimeError('Missing hosts block: ' + service)
    for i in range(a + 1, b):
        stripped = lines[i].lstrip()
        indent = lines[i][:len(lines[i]) - len(stripped)]
        if unlock and re.match(r'^(127\.0\.0\.1|0\.0\.0\.0|::1)\s+\S+', stripped):
            lines[i] = indent + PREFIX + stripped
        elif not unlock and stripped.startswith(PREFIX):
            lines[i] = indent + stripped[len(PREFIX):]
    return ''.join(lines)


def enforce_permanent_text(text):
    enforced = text
    for service in PERMANENT_BLOCKS:
        start = '# === FOCUS_BLOCK:' + service.upper() + ' START ==='
        end = '# === FOCUS_BLOCK:' + service.upper() + ' END ==='
        if start not in enforced and end not in enforced:
            if enforced and not enforced.endswith('\n'):
                enforced += '\n'
            enforced += start + '\n'
            for ip in ('127.0.0.1', '::1'):
                for domain in PERMANENT_DOMAINS[service]:
                    enforced += ip + ' ' + domain + '\n'
            enforced += end + '\n'
        else:
            enforced = transform(enforced, service, False)
    return enforced


@contextlib.contextmanager
def locked():
    with (BASE / 'lock').open('a') as file:
        fcntl.flock(file, fcntl.LOCK_EX)
        yield


def write_hosts(text):
    # Same filesystem, atomic replacement: never leave a truncated hosts file.
    tmp = Path('/etc/hosts.focus-open.tmp')
    with tmp.open('w') as file:
        file.write(text)
        file.flush()
        os.fsync(file.fileno())
    tmp.chmod(0o644)
    tmp.replace(HOSTS)


def flush():
    for args in (['/usr/bin/dscacheutil', '-flushcache'], ['/usr/bin/killall', '-HUP', 'mDNSResponder']):
        subprocess.run(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)


def read_lease():
    return json.loads(STATE.read_text()) if STATE.exists() else None


# Educational access is policy, never a lease. Only ordinary videos and social
# windows occupy lease.json. Browser snapshots are shared across all guards.
OBSERVED = {service: set() for service in TEMPORARY_SERVICES}


def set_access(service, unlock):
    text = HOSTS.read_text()
    changed = transform(text, service, unlock)
    if changed != text:
        write_hosts(changed)
        flush()


def close_matching(predicate, observed=(), browsers=None):
    try:
        report = youtube.browser_report(strict_unsupported=False, browsers=browsers, tolerate_errors=True)
    except Exception:
        if not observed:
            raise
        youtube.force_stop_browsers(set(observed))
        return
    failures = set(getattr(report, 'errors', {}))
    targets = youtube.targets_for(report, predicate)
    names = {t['application'] for t in targets}
    try:
        youtube.close_tabs(targets)
        verify = youtube.browser_report(strict_unsupported=False, browsers=names, tolerate_errors=True) if names else []
        failures.update(getattr(verify, 'errors', {}))
        remaining = {t['application'] for t in youtube.targets_for(verify, predicate)}
        reset = remaining | (failures & (set(observed) | names))
        if reset:
            youtube.force_stop_browsers(reset)
    except Exception:
        reset = names | (set(observed) & failures)
        if not reset:
            raise
        youtube.force_stop_browsers(reset)


def lease_services(current):
    if not current:
        return set()
    primary = current['service']
    result = {primary}
    # Additional social sites can only be written by an administrator into
    # the protected lease. Ordinary grant commands never accept this field.
    extra = current.get('additional_services', [])
    if primary in SOCIAL_SERVICES and isinstance(extra, list):
        result.update(s for s in extra if isinstance(s, str) and s in SOCIAL_SERVICES)
    return result


def revoke_lease():
    current = read_lease()
    if not current:
        return
    service = current['service']
    services = lease_services(current)
    for name in sorted(services):
        set_access(name, False)
    observed = current.get('observed_browsers', [])
    if service == 'youtube':
        study = youtube.study_scope(youtube.read_policy())
        close_matching(lambda u: youtube.is_youtube_surface(u) and not youtube.url_allowed(study, u), observed)
    else:
        close_matching(lambda u: socials.service_for_url(u) in services, observed)
    # Keep an unrevoked record if closure fails; the daemon can retry it.
    STATE.unlink(missing_ok=True)


def restore():
    revoke_lease()
    for service in SOCIAL_SERVICES:
        set_access(service, False)
    guard_cycle()  # A manual restore cannot expire educational policy.


def stop_session(expected):
    if (not isinstance(expected, dict) or set(expected) != {'service', 'started_at'} or
            expected['service'] not in TEMPORARY_SERVICES or
            isinstance(expected['started_at'], bool) or not isinstance(expected['started_at'], (int, float)) or
            not math.isfinite(expected['started_at']) or expected['started_at'] <= 0):
        raise ValueError('Invalid session stop token')
    current = read_lease()
    if not current:
        return {'stopped': False}
    if current['service'] != expected['service'] or current['started_at'] != expected['started_at']:
        raise RuntimeError('Активная сессия изменилась; она не была остановлена. Повтори команду.')
    revoke_lease()
    # Ending never refunds a day or video use. Study access needs a live guard.
    if timer_running():
        guard_cycle()
    else:
        set_access('youtube', False)
    return {'stopped': True, 'service': current['service'], 'started_at': current['started_at']}


def daily_available():
    now = time.time()
    usage = socials.read_usage()
    result = {}
    for service, seconds in socials.DURATIONS.items():
        try:
            socials.validate(service, seconds, usage, now)
        except RuntimeError:
            result[service] = False
        else:
            result[service] = True
    last = youtube.read_usage().get('last_regular_opened_at')
    result['youtube'] = last is None or socials.day_at(now) > socials.day_at(float(last))
    return result


def timer_running():
    # launchd owns the installed service identity. The helper may hold the
    # shared lock during browser inspection, so heartbeat age is not a valid
    # liveness test at the end of that same inspection.
    result = subprocess.run(['/bin/launchctl', 'print', 'system/local.focus-open.timer'],
                            capture_output=True, text=True, timeout=3)
    if result.returncode or not re.search(r'^\s*state = running\s*$', result.stdout, re.MULTILINE):
        return False
    match = re.search(r'^\s*pid = ([0-9]+)\s*$', result.stdout, re.MULTILINE)
    if not match:
        return False
    try:
        os.kill(int(match.group(1)), 0)
    except ProcessLookupError:
        return False
    return True


def require_timer():
    if not HEARTBEAT.exists() or not timer_running():
        raise RuntimeError('Служба автоблокировки не запущена; доступ остаётся закрыт.')


def require_observer():
    health = json.loads(youtube.HEALTH.read_text()) if youtube.HEALTH.exists() else {}
    age = time.time() - health.get('checked_at', 0)
    if not health.get('ok') or age < -1 or age > 10:
        raise RuntimeError(health.get('error') or 'Browser observer is unavailable')


def lease_clock():
    # macOS Python 3.9 time.monotonic() has a process-local epoch. POSIX
    # CLOCK_MONOTONIC shares its origin between the grant CLI and the daemon.
    return time.clock_gettime(time.CLOCK_MONOTONIC)


def lease(service, seconds, youtube_scope=None):
    require_no_focus()
    if service not in TEMPORARY_SERVICES or isinstance(seconds, bool) or not isinstance(seconds, int) or not 1 <= seconds <= 21600:
        raise ValueError('Invalid lease')
    if service == 'youtube' and (not youtube_scope or youtube_scope.get('mode') != 'video'):
        raise ValueError('Only ordinary video access needs a temporary lease')
    now = time.time()
    previous = None
    if service in socials.DURATIONS:
        previous = socials.read_usage()
        socials.validate(service, seconds, previous, now)
    require_timer()
    require_observer()
    if read_lease():
        raise RuntimeError('Another temporary lease is active')
    # Check hosts configuration before reserving a protected quota.
    text = transform(HOSTS.read_text(), service, True)
    mono = lease_clock()
    value = {'service': service, 'started_at': now, 'started_monotonic': mono,
             'deadline': now + seconds, 'deadline_monotonic': mono + seconds,
             'timer_clock': 'system_monotonic_v1',
             'observed_browsers': []}
    if service == 'youtube':
        value['youtube_scope'] = dict(youtube_scope, grace_until=now + 15)
    youtube.atomic_json(STATE, value)
    if previous is not None:
        # Reserve before unblocking. Killing a caller or editing its state can
        # never create another successful seven-minute Telegram window.
        youtube.atomic_json(socials.USAGE, socials.reserve(service, previous, now))
    try:
        write_hosts(text)
        flush()
    except BaseException:
        set_access(service, False)
        raise
    return value


def expire():
    current = read_lease()
    if current and (time.time() >= current['deadline'] or
                    (current.get('timer_clock') == 'system_monotonic_v1' and
                     lease_clock() >= current.get('deadline_monotonic', float('inf')))):
        revoke_lease()


def enforce_permanent_blocks():
    text = HOSTS.read_text()
    enforced = enforce_permanent_text(text)
    if enforced != text:
        write_hosts(enforced)
        flush()


def remember_report(report, current):
    for service in TEMPORARY_SERVICES:
        predicate = youtube.is_youtube_surface if service == 'youtube' else lambda u: socials.service_for_url(u) == service
        OBSERVED[service] = (OBSERVED[service] & set(getattr(report, 'errors', {}))) | {t['application'] for t in youtube.targets_for(report, predicate)}
    if current:
        names = sorted(set().union(*(OBSERVED[s] for s in lease_services(current))))
        if names != current.get('observed_browsers', []):
            current['observed_browsers'] = names
            youtube.atomic_json(STATE, current)


def guard_cycle():
    current = read_lease()
    focus = study_lock.read()['session']
    focusing = bool(focus and focus['phase'] == 'focus')
    set_study_web(focusing)
    study = youtube.study_scope(youtube.read_policy())
    scope = dict(current['youtube_scope'], study_ids=study['allowed_ids'], playlist_ids=study['playlist_ids'], channel_ids=study.get('channel_ids', []), channel_paths=study.get('channel_paths', []), channel_video_ids=study.get('channel_video_ids', [])) if current and current['service'] == 'youtube' else study
    try:
        report = youtube.browser_report(tolerate_errors=True)
        if focusing:
            targets = youtube.targets_for(report, lambda u: bool(study_lock.distraction_site(u)))
            if targets:
                for site in {study_lock.distraction_site(t['url']) for t in targets}:
                    study_lock.record_attempt('site', site)
                youtube.close_tabs(targets)
                report = youtube.browser_report(tolerate_errors=True)
                remaining = youtube.targets_for(report, lambda u: bool(study_lock.distraction_site(u)))
                if remaining:
                    youtube.force_stop_browsers({t['application'] for t in remaining})
                    report = youtube.browser_report(tolerate_errors=True)
        observer_errors = dict(getattr(report, 'errors', {}))
        denied = youtube.targets_for(report, lambda u: youtube.is_youtube_surface(u) and not youtube.url_allowed(scope, u))
        if denied:
            study_lock.record_attempt('site', 'youtube')
            set_access('youtube', False)
            # An outside video revokes only the ordinary-video entitlement.
            # Lectures and an unrelated Telegram/Instagram timer remain intact.
            if current and current['service'] == 'youtube':
                STATE.unlink(missing_ok=True)
                current = None
            report = youtube.browser_report(tolerate_errors=True)
            observer_errors = dict(getattr(report, 'errors', {}))
            targets = youtube.targets_for(report, lambda u: youtube.is_youtube_surface(u) and not youtube.url_allowed(study, u))
            seen = {(t['application'], t['window'], t['tab']) for t in targets}
            targets.extend(t for t in denied if (t['application'], t['window'], t['tab']) not in seen)
            youtube.close_tabs(targets)
            report = youtube.browser_report(tolerate_errors=True)
            observer_errors = dict(getattr(report, 'errors', {}))
            if youtube.targets_for(report, lambda u: youtube.is_youtube_surface(u) and not youtube.url_allowed(study, u)):
                raise RuntimeError('Не удалось закрыть запрещённое видео')
            preview = any(youtube.is_video_preview_url(t['url']) for t in targets)
            youtube.record_event('preview_blocked' if preview else 'forbidden',
                                 'Видеопредпросмотр закрыт; используйте прямую ссылку YouTube' if preview else 'Посторонняя вкладка закрыта; лекции доступны постоянно',
                                 {t['application'] for t in targets})
        for service in SOCIAL_SERVICES:
            allowed = service in lease_services(current)
            set_access(service, allowed)
            if not allowed:
                targets = youtube.targets_for(report, lambda u: socials.service_for_url(u) == service)
                if targets:
                    study_lock.record_attempt('site', service)
                    youtube.close_tabs(targets)
                    report = youtube.browser_report(tolerate_errors=True)
                    observer_errors = dict(getattr(report, 'errors', {}))
                    if youtube.targets_for(report, lambda u: socials.service_for_url(u) == service):
                        raise RuntimeError('Не удалось закрыть вкладку ' + service)
        remember_report(report, current)
        # Always enabled after a successful observer pass, including an empty
        # browser. Opening an approved lecture needs no command or renewal.
        if observer_errors:
            set_access('youtube', False)
            # Reset cached denied connections only in the failed browser. The
            # healthy Arc carrying Telegram is not selected for a Chrome error.
            blocked = {'youtube'} | (set(SOCIAL_SERVICES) - lease_services(current))
            reset = set().union(*(OBSERVED[s] for s in blocked)) & set(observer_errors) & set(youtube.BROWSERS)
            if reset:
                youtube.force_stop_browsers(reset)
                for names in OBSERVED.values():
                    names.difference_update(reset)
            detail = '; '.join(name + ': ' + error[:200] for name, error in observer_errors.items())
            youtube.publish_health(False, detail)
            youtube.record_event('observer_error', detail, observer_errors)
            # The authorized social deadline remains unchanged even if a
            # browser had to be reset. Reopening Telegram is still permitted.
            return False
        set_access('youtube', True)
        youtube.publish_health(True)
    except Exception as error:
        set_access('youtube', False)
        active_social = lease_services(current) & set(SOCIAL_SERVICES)
        blocked = {'youtube'}
        for service in SOCIAL_SERVICES:
            allowed = service in active_social
            set_access(service, allowed)
            if not allowed:
                blocked.add(service)
        names = set().union(*(OBSERVED[s] for s in blocked))
        youtube.publish_health(False, str(error))
        youtube.record_event('observer_error', str(error)[:500], names)
        try:
            close_matching(lambda u: youtube.is_youtube_surface(u) or socials.service_for_url(u) in blocked, names)
        except Exception as cleanup_error:
            youtube.record_event('cleanup_error', str(cleanup_error)[:500], names)
            raise
        # An observer failure is not an expiry. In particular, do not erase a
        # valid Telegram/Instagram grant and leave it impossible to reopen.
        if current and current['service'] == 'youtube':
            STATE.unlink(missing_ok=True)
        return False
    return True


def startup():
    # Revoke temporary grants on restart while retaining lecture tabs. Global
    # YouTube DNS is opened only after the installed observer confirms policy.
    set_access('youtube', False)
    revoke_lease()
    for service in SOCIAL_SERVICES:
        set_access(service, False)
    set_study_web(bool(study_lock.read()['session'] and study_lock.read()['session']['phase'] == 'focus'))
    youtube.publish_health(False, 'Проверка после запуска')


def main():
    if os.geteuid() != 0:
        raise RuntimeError('Requires installed sudo permission')
    args = sys.argv[1:]
    if args == ['daemon']:
        with locked():
            startup()
        playlist_sync.start_worker(locked)
        while True:
            with locked():
                try:
                    expire()
                    enforce_permanent_blocks()
                    try:
                        guard_study_apps()
                    except Exception as app_error:
                        study_lock.app_health(str(app_error)[:500])
                        youtube.record_event('study_app_error', str(app_error)[:500], [])
                    guard_cycle()
                except Exception as error:
                    youtube.publish_health(False, str(error))
                    youtube.record_event('daemon_error', str(error), [])
                HEARTBEAT.touch()
            time.sleep(0.5)
    duration = None
    request = None
    # Input is parsed outside the daemon lock, preventing an idle pipe from
    # freezing every timer. No executable caller input reaches the observer.
    if len(args) == 2 and args[0] == 'lease' and args[1] in TEMPORARY_SERVICES:
        if args[1] == 'youtube':
            request = json.loads(sys.stdin.read(4096))
        else:
            duration = int(sys.stdin.read(16))
    if args == ['youtube-duration']:
        duration = int(sys.stdin.read(16))
    if args == ['stop']:
        request = json.loads(sys.stdin.read(4096))
    if args in (['study-start'], ['study-emergency-request'], ['study-emergency-confirm']):
        request = json.loads(sys.stdin.read(32768))
    with locked():
        if args == ['study-status']:
            print(json.dumps(dict(study_status(), service_running=timer_running()), ensure_ascii=False))
        elif args == ['study-start']:
            print(json.dumps(start_study(request), ensure_ascii=False))
        elif args == ['study-emergency-request']:
            print(json.dumps(study_lock.request_emergency(request, boot_identity()), ensure_ascii=False))
        elif args == ['study-emergency-confirm']:
            print(json.dumps(study_lock.confirm_emergency(request, boot_identity()), ensure_ascii=False))
        elif args == ['check']:
            require_timer()
        elif args == ['restore']:
            restore()
        elif args == ['stop']:
            print(json.dumps(stop_session(request), ensure_ascii=False))
        elif args == ['youtube-policy']:
            print(json.dumps(youtube.read_policy(), ensure_ascii=False))
        elif args == ['youtube-status']:
            print(json.dumps({'usage': youtube.read_usage(), 'lease': read_lease(),
                             'daily_available': daily_available(),
                             'study': youtube.study_scope(youtube.read_policy()),
                             'health': json.loads(youtube.HEALTH.read_text()) if youtube.HEALTH.exists() else None,
                             'last_event': json.loads(youtube.LAST_EVENT.read_text()) if youtube.LAST_EVENT.exists() else None}, ensure_ascii=False))
        elif args == ['guard-check']:
            require_observer()
        elif args == ['youtube-duration']:
            require_no_focus()
            current = read_lease()
            if not current or current.get('youtube_scope', {}).get('mode') != 'video':
                raise RuntimeError('No single-video session is active')
            if duration is None or not 1 <= duration <= 21600:
                raise ValueError('Invalid duration')
            current['deadline'] = current['started_at'] + duration
            current['deadline_monotonic'] = current['started_monotonic'] + duration
            youtube.atomic_json(STATE, current)
            print(json.dumps({'deadline': current['deadline']}))
        elif len(args) == 2 and args[0] == 'lease' and args[1] in TEMPORARY_SERVICES:
            if args[1] == 'youtube':
                require_timer()
                require_observer()
                previous = youtube.read_usage()
                scope = youtube.make_scope(request, youtube.read_policy(), previous, time.time())
                if scope['mode'] == 'playlist':
                    # Compatible with older terminal commands, but never creates
                    # a timed educational grant or blocks a social window.
                    print(json.dumps({'deadline': None, 'scope': scope}, ensure_ascii=False))
                    return
                require_no_focus()
                if read_lease():
                    raise RuntimeError('Another temporary lease is active')
                youtube.prepare_session(scope)
                require_timer()  # Recheck the actual service after native calls.
                youtube.publish_health(True)  # This complete snapshot was verified now.
                started = time.time()
                usage = copy.deepcopy(previous)
                usage['last_regular_opened_at'] = started
                counts = usage.setdefault('counts', {})
                counts[scope['allowed_ids'][0]] = counts.get(scope['allowed_ids'][0], 0) + 1
                youtube.atomic_json(youtube.USAGE, usage)
                try:
                    value = lease('youtube', scope['seconds'], scope)
                except BaseException:
                    # A definite refusal before writing a lease grants no access.
                    # Restore the reservation instead of consuming the cooldown.
                    # An uncertain outcome with a lease stays reserved/fails closed.
                    if not read_lease():
                        youtube.atomic_json(youtube.USAGE, previous)
                    raise
                print(json.dumps({'deadline': value['deadline'], 'scope': scope}, ensure_ascii=False))
            else:
                lease(args[1], duration)
        else:
            raise ValueError('Unsupported command')


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
