#!/usr/bin/python3 -I
"""Root-owned, fixed-scope hosts lease helper. No user code is imported."""
import contextlib
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time

BASE = Path('/Library/PrivilegedHelperTools/focus-open')
HOSTS = Path('/etc/hosts')
STATE = BASE / 'lease.json'
HEARTBEAT = BASE / 'heartbeat'
PREFIX = '# TEMP_FOCUS_UNLOCK '
TEMPORARY_SERVICES = ('youtube', 'instagram', 'telegram')
PERMANENT_BLOCKS = ('vkvideo',)
PERMANENT_DOMAINS = {
    'vkvideo': (
        'vkvideo.ru', 'www.vkvideo.ru', 'm.vkvideo.ru',
        'api.vkvideo.ru', 'live.vkvideo.ru', 'api.live.vkvideo.ru',
        'video.vk.com',
    ),
}


def transform(text, service, unlock):
    lines = text.splitlines(keepends=True)
    start = '# === FOCUS_BLOCK:' + service.upper() + ' START ==='
    end = '# === FOCUS_BLOCK:' + service.upper() + ' END ==='
    a = next((i for i, line in enumerate(lines) if line.strip() == start), None)
    b = next((i for i, line in enumerate(lines) if line.strip() == end), None)
    if a is None or b is None or b <= a:
        raise RuntimeError('Missing hosts block: ' + service)
    for i in range(a + 1, b):
        stripped = lines[i].lstrip()
        indent = lines[i][:len(lines[i]) - len(stripped)]
        if unlock and re.match(r'^(127\.0\.0\.1|0\.0\.0\.0|::1)\s+\S+', stripped):
            lines[i] = indent + PREFIX + stripped
        elif not unlock and stripped.startswith(PREFIX):
            lines[i] = indent + stripped[len(PREFIX):]
    return ''.join(lines)


def enforce_permanent_text(text):
    enforced = text
    for service in PERMANENT_BLOCKS:
        start = '# === FOCUS_BLOCK:' + service.upper() + ' START ==='
        end = '# === FOCUS_BLOCK:' + service.upper() + ' END ==='
        if start not in enforced and end not in enforced:
            if enforced and not enforced.endswith('\n'):
                enforced += '\n'
            enforced += start + '\n'
            for ip in ('127.0.0.1', '::1'):
                for domain in PERMANENT_DOMAINS[service]:
                    enforced += ip + ' ' + domain + '\n'
            enforced += end + '\n'
        else:
            enforced = transform(enforced, service, False)
    return enforced


@contextlib.contextmanager
def locked():
    with (BASE / 'lock').open('a') as file:
        fcntl.flock(file, fcntl.LOCK_EX)
        yield


def write_hosts(text):
    # Same filesystem, atomic replacement: never leave a truncated hosts file.
    tmp = Path('/etc/hosts.focus-open.tmp')
    with tmp.open('w') as file:
        file.write(text)
        file.flush()
        os.fsync(file.fileno())
    tmp.chmod(0o644)
    tmp.replace(HOSTS)


def flush():
    for args in (['/usr/bin/dscacheutil', '-flushcache'], ['/usr/bin/killall', '-HUP', 'mDNSResponder']):
        subprocess.run(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)


def read_lease():
    return json.loads(STATE.read_text()) if STATE.exists() else None


def stop_browser():
    config = json.loads((BASE / 'config.json').read_text())
    # Fixed process and fixed installation owner; caller cannot select a target.
    subprocess.run(['/usr/bin/killall', '-KILL', '-u', config['username'], 'Arc'],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)


def restore():
    lease = read_lease()
    text = HOSTS.read_text()
    restored = text
    for service in TEMPORARY_SERVICES:
        restored = transform(restored, service, False)
    restored = enforce_permanent_text(restored)
    stop_error = None
    if lease or restored != text:
        # Restore hosts even if process termination itself encounters an error.
        try:
            stop_browser()
        except Exception as error:
            stop_error = error
    if restored != text:
        write_hosts(restored)
    flush()
    if stop_error is not None:
        raise stop_error
    if STATE.exists():
        STATE.unlink()


def lease(service, seconds):
    if service not in TEMPORARY_SERVICES or not 1 <= seconds <= 6 * 60 * 60:
        raise ValueError('Invalid lease')
    if not HEARTBEAT.exists() or time.time() - HEARTBEAT.stat().st_mtime > 3:
        raise RuntimeError('Focus timer unavailable; access stays blocked')
    if read_lease():
        raise RuntimeError('Another lease is active')
    text = transform(HOSTS.read_text(), service, True)
    # Persist deadline BEFORE unblocking, so even a crash is recoverable.
    STATE.write_text(json.dumps({'service': service, 'deadline': time.time() + seconds}))
    STATE.chmod(0o600)
    try:
        write_hosts(text)
        flush()
    except BaseException:
        restore()
        raise


def expire():
    value = read_lease()
    if value and time.time() >= value['deadline']:
        restore()


def enforce_permanent_blocks():
    text = HOSTS.read_text()
    enforced = enforce_permanent_text(text)
    if enforced != text:
        stop_browser()
        write_hosts(enforced)
        flush()


def main():
    if os.geteuid() != 0:
        raise RuntimeError('Requires installed sudo permission')
    args = sys.argv[1:]
    if args == ['daemon']:
        with locked():
            restore()  # Restart/reboot always fails closed.
        while True:
            with locked():
                expire()
                enforce_permanent_blocks()
                HEARTBEAT.touch()
            time.sleep(0.5)
    # Never hold the global lock while waiting for caller input: the daemon
    # must remain free to expire a different lease even if stdin stays open.
    duration = None
    if len(args) == 2 and args[0] == 'lease' and args[1] in TEMPORARY_SERVICES:
        duration = int(sys.stdin.read(16))
    with locked():
        if args == ['check']:
            if not HEARTBEAT.exists() or time.time() - HEARTBEAT.stat().st_mtime > 3:
                raise RuntimeError('Focus timer is not running')
        elif args == ['restore']:
            restore()
        elif len(args) == 2 and args[0] == 'lease' and args[1] in TEMPORARY_SERVICES:
            lease(args[1], duration)
        else:
            raise ValueError('Unsupported command')


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
